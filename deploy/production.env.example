# Salin ke backend/.env di VPS. APP_KEY, JWT_SECRET, dan DB_PASSWORD diisi
# lewat perintah di deploy/README.md. Jangan pernah di-commit.

APP_NAME=LeoChat
APP_ENV=production
# Harus tepat 32 karakter: openssl rand -hex 16
APP_KEY=
APP_DEBUG=false

LOG_CHANNEL=stack
LOG_LEVEL=info

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Dipakai untuk membentuk URL foto profil.
APP_URL=https://l.duzi.live
# Hanya bisa diakses dari VPS sendiri. Nginx yang meneruskan dari luar.
APP_HOST=127.0.0.1
APP_PORT=3003

# openssl rand -hex 32
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=43200

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# MySQL yang sudah jalan di host.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leochat
DB_USERNAME=leochat
DB_PASSWORD=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Redis dari docker-compose.prod.yml (port 6380 supaya tidak bentrok).
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6380
